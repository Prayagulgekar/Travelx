# Copy to .env.local for local development. Never commit real values.

# Supabase project (Project Settings → API Keys; on newer projects use the "Legacy API keys" tab:
# the anon and service_role keys. The newer sb_publishable_/sb_secret_ keys are untested with this app.)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_fQgPxMQWcn6mRxiJKFJq_A_R_xu2-AX

# Server-only. Used for team invitations and the daily maintenance job. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of this app (used in auth email links). No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shared secret for /api/cron/daily (Vercel Cron sends it as a Bearer token). 32+ random characters.
CRON_SECRET=

# Optional: quotation emails via Resend. Leave empty to disable (the UI then offers PDF download only).
RESEND_API_KEY=
EMAIL_FROM=
